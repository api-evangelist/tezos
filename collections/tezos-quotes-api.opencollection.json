{
  "opencollection": "1.0.0",
  "info": {
    "name": "TzKT Accounts Quotes API",
    "version": "1.17.1"
  },
  "items": [
    {
      "info": {
        "name": "Quotes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get quotes count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tzkt.io/v1/quotes/count"
          },
          "docs": "Returns the total number of quotes aligned with blocks."
        },
        {
          "info": {
            "name": "Get last quote",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tzkt.io/v1/quotes/last"
          },
          "docs": "Returns last known quote."
        },
        {
          "info": {
            "name": "Get quotes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tzkt.io/v1/quotes",
            "params": [
              {
                "name": "level",
                "value": "",
                "type": "query",
                "description": "Filters quotes by level."
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query",
                "description": "Filters quotes by timestamp."
              },
              {
                "name": "select",
                "value": "",
                "type": "query",
                "description": "Specify comma-separated list of fields to include into response or leave it undefined to return full object. If you select single field, response will be an array of values in both `.fields` and `.values` modes."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorts quotes by specified field. Supported fields: `level` (default)."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Specifies which or how many items should be skipped"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              }
            ]
          },
          "docs": "Returns a list of quotes aligned with blocks."
        }
      ]
    }
  ],
  "bundled": true
}